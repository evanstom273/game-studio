{
  // Game Studio: a Cloudflare Worker with Static Assets.
  //  - Static assets: the editor (Vite build), the player frame and the game runtime bundles.
  //  - worker/index.ts handles only /mcp* (AI apps) and /bridge/* (the editor's WebSocket);
  //    everything else is served straight from the assets.
  // Projects live in each user's browser (IndexedDB). The relay stores no project data.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "game-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./apps/editor/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/mcp", "/mcp/*", "/bridge/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayRoom" }]
  },
  // SQLite-backed Durable Objects are available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom"] }],
  "observability": { "enabled": true },
  "workers_dev": true
}
