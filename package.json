{
  "name": "game-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Game Studio: a Godot-inspired, browser-first 2D/3D game engine and editor with TypeScript scripting and MCP integration.",
  "scripts": {
    "dev": "vite --config apps/editor/vite.config.ts",
    "build": "vite build --config apps/editor/vite.config.ts",
    "preview": "vite preview --config apps/editor/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@babel/parser": "^8.1.2",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@dimforge/rapier2d-compat": "^0.21.0",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@lezer/highlight": "^1.2.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xyflow/react": "^12.12.1",
    "blakejs": "^1.2.1",
    "dexie": "^4.4.7",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.73.0",
    "pixi.js": "^8.23.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "tweetnacl": "^1.0.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0",
    "ws": "^8.23.0"
  }
}
