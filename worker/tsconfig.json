{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": "..",
    "paths": { "@gs/shared": ["packages/shared/src/index.ts"] }
  },
  "include": ["*.ts", "../packages/mcp/src/*.ts"]
}
