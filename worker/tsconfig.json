{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": "..",
    "paths": {
      "@gs/shared": ["packages/shared/src/index.ts"],
      "@gs/core": ["packages/core/src/index.ts"],
      "@gs/project": ["packages/project/src/index.ts"]
    }
  },
  "include": ["*.ts", "../packages/mcp/src/**/*.ts"]
}
